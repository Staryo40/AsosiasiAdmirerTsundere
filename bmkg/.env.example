# BMKG configuration. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.
#
# Each variable below states:
#   Used by: who holds or reads this value
#   Purpose: how it is used and what for

# --- Credential ------------------------------------------------------------

# Used by: the one caller BMKG serves, the BNPB gateway. BMKG checks it on every request.
# Purpose: the shared secret sent as the `X-BMKG-Key` header on every call to /seismic-events and
#          /tsunami-warnings. Unlike PVMBG, BMKG has no login step: this key is the credential itself,
#          not something exchanged for a token. Keep it different from anything used by PVMBG.
BMKG_API_KEY=change-me

# --- Optional tuning (defaults shown) ---------------------------------------

# Used by: BMKG only, to decide which port to listen on.
# Purpose: the TCP port the HTTP server binds to. Default 8081 (the port the spec assigns to BMKG).
BMKG_PORT=8081

# Used by: BMKG only, in the code that slows down its responses.
# Purpose: the lower bound, in milliseconds, of the random delay added to every response. BMKG's
#          characteristic (unlike PVMBG's) is a low and consistent delay. Default 50.
#          Must not be greater than BMKG_RESPONSE_DELAY_MAX_MS, otherwise BMKG refuses to start.
BMKG_RESPONSE_DELAY_MIN_MS=50

# Used by: BMKG only, in the code that slows down its responses.
# Purpose: the upper bound, in milliseconds, of the same random delay. Default 150, giving the
#          spec's fixed 50-150 ms range. Set both bounds equal for an exact fixed delay.
BMKG_RESPONSE_DELAY_MAX_MS=150

# Used by: BMKG only, in the code that creates new seismic events while the service runs.
# Purpose: how many seconds pass between two newly generated events. Default 10 (one new event every
#          10 seconds, the spec's minimum rate); use a smaller value such as 2 or 0.5 to speed up demos.
#          Decimals are allowed, but it must be at least 0.001.
BMKG_GENERATOR_INTERVAL_SECONDS=10

# Used by: BMKG's logging system only, read when the service starts.
# Purpose: the minimum severity written to the log: TRACE, DEBUG, INFO, WARN, ERROR or OFF. Default INFO.
BMKG_LOG_LEVEL=INFO

# Used by: BMKG's logging system, and by whoever reads the output (`docker compose logs`, the demo).
# Purpose: the shape of every log line. `json` (default) writes one JSON object per line. `text` writes
#          readable lines for a developer's console. Must be lowercase.
BMKG_LOG_FORMAT=json
