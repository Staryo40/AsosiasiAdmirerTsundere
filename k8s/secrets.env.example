# Copy to k8s/secrets.env (git-ignored) and fill every value;
# KUBERNETES-DEPLOYMENT.md has a generator. Use hex values: some are embedded in connection URLs.

POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_PASS=
BNPB_RABBITMQ_PUBLISHER_PASSWORD=
BNPB_CONSUMER_1_RABBITMQ_PASSWORD=
BNPB_CONSUMER_2_RABBITMQ_PASSWORD=
BNPB_CONSUMER_3_RABBITMQ_PASSWORD=

BNPB_AGGREGATOR_INTERNAL_KEY=
BNPB_AUTH_INTERNAL_KEY=
BNPB_MEDIA_CLIENT_SECRET=
BNPB_FIELD_CLIENT_SECRET=
BNPB_OPS_CLIENT_SECRET=

# Shared by each mock and the Aggregator that calls it.
BMKG_API_KEY=
PVMBG_READER_CLIENT_SECRET=
PVMBG_JWT_SECRET=
PVMBG_ADMIN_CLIENT_SECRET=

# Field reports: the API publishes and field-intake consumes field.reports.
BNPB_API_RABBITMQ_PASSWORD=
BNPB_FIELD_INTAKE_RABBITMQ_PASSWORD=
BNPB_FIELD_INTAKE_INTERNAL_KEY=

# Satellite service to Aggregator; the feed token itself lives in Secret satellite-token.
BNPB_SATELLITE_INGEST_TOKEN=
# Aggregator DLQ metadata API and Audit API.
BNPB_UNPROCESSED_API_TOKEN=
BNPB_AUDIT_TOKEN=
