BNPB_AI_SUMMARIZER_HTTP_ADDR=:8090
BNPB_AI_SUMMARIZER_DB_PATH=/data/ai-summarizer.db
BNPB_AI_SUMMARIZER_PROVIDERS=anthropic,openrouter,gemini
BNPB_AI_SUMMARIZER_ANTHROPIC_MODEL=claude-haiku-5-5
# Fill the model IDs you chose for OpenRouter and Gemini; empty skips that provider.
BNPB_AI_SUMMARIZER_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
BNPB_AI_SUMMARIZER_GEMINI_MODEL=
BNPB_AI_SUMMARIZER_INTERVAL=60s
BNPB_AI_SUMMARIZER_WINDOW=60m
BNPB_AI_SUMMARIZER_FAULT=
