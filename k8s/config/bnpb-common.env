BNPB_LOG_LEVEL=INFO
BNPB_MAX_IN_FLIGHT=64
BNPB_OUTBOUND_HTTP_TIMEOUT=5s
BNPB_READ_HEADER_TIMEOUT=5s
BNPB_READ_TIMEOUT=10s
BNPB_WRITE_TIMEOUT=10s
BNPB_IDLE_TIMEOUT=60s
BNPB_SHUTDOWN_TIMEOUT=5s
# Every Go service exports spans here (k8s/monitoring/tempo.yaml); remove it to turn tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc.cluster.local:4318
