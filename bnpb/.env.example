POSTGRES_DB=bnpb
POSTGRES_USER=bnpb
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_USER=bnpb
RABBITMQ_DEFAULT_PASS=

# Shared service platform settings
BNPB_LOG_LEVEL=INFO
BNPB_MAX_IN_FLIGHT=64
BNPB_OUTBOUND_HTTP_TIMEOUT=5s
BNPB_READ_HEADER_TIMEOUT=5s
BNPB_READ_TIMEOUT=10s
BNPB_WRITE_TIMEOUT=10s
BNPB_IDLE_TIMEOUT=60s
BNPB_SHUTDOWN_TIMEOUT=5s

# Per-service listen addresses
BNPB_API_HTTP_ADDR=:8080
BNPB_AGGREGATOR_HTTP_ADDR=:8083
BNPB_AUTH_HTTP_ADDR=:8084
BNPB_CONSUMER_1_HTTP_ADDR=:8085
BNPB_CONSUMER_2_HTTP_ADDR=:8086
BNPB_CONSUMER_3_HTTP_ADDR=:8087
