POSTGRES_DB=bnpb
POSTGRES_USER=bnpb
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_USER=bnpb
RABBITMQ_DEFAULT_PASS=

# Shared service platform settings
BNPB_LOG_LEVEL=INFO
BNPB_MAX_IN_FLIGHT=64
BNPB_OUTBOUND_HTTP_TIMEOUT=5s
BNPB_READ_HEADER_TIMEOUT=5s
BNPB_READ_TIMEOUT=10s
BNPB_WRITE_TIMEOUT=10s
BNPB_IDLE_TIMEOUT=60s
BNPB_SHUTDOWN_TIMEOUT=10s

# Per-service listen addresses
BNPB_API_HTTP_ADDR=:8080
BNPB_AGGREGATOR_HTTP_ADDR=:8083
BNPB_AUTH_HTTP_ADDR=:8084
BNPB_CONSUMER_1_HTTP_ADDR=:8085
BNPB_CONSUMER_2_HTTP_ADDR=:8086
BNPB_CONSUMER_3_HTTP_ADDR=:8087

# Auth is internal. Client API authenticates with a dedicated key and proxies
# public login, refresh and introspection flows over the backend network.
BNPB_AUTH_ACCESS_TOKEN_TTL=60s
BNPB_AUTH_REFRESH_SESSION_TTL=8h
BNPB_AUTH_INTERNAL_KEY=

# Three independent downstream identities. Use random secrets of at least 32 bytes.
BNPB_MEDIA_CLIENT_ID=media
BNPB_MEDIA_CLIENT_SECRET=
BNPB_FIELD_CLIENT_ID=field-team
BNPB_FIELD_CLIENT_SECRET=
BNPB_OPS_CLIENT_ID=internal-ops
BNPB_OPS_CLIENT_SECRET=

# API dependency readiness (no database or agency credentials).
BNPB_AGGREGATOR_BASE_URL=http://aggregator:8083
BNPB_AUTH_BASE_URL=http://auth:8084

# Aggregator-only settings
BNPB_BMKG_BASE_URL=http://bmkg:8081
BNPB_PVMBG_BASE_URL=http://pvmbg:8082
BNPB_PANTAI_BASE_URL=http://sensor-pantai:8080
BNPB_PANTAI_AUTH_TOKEN=
BNPB_PANTAI_POLL_INTERVAL=3s
BNPB_PANTAI_HTTP_TIMEOUT=2s
BNPB_PANTAI_BREAKER_FAILURES=5
BNPB_PANTAI_BREAKER_COOLDOWN=30s
BNPB_PANTAI_MAX_IN_FLIGHT=1

BNPB_BMKG_API_KEY=
BNPB_PVMBG_READER_CLIENT_ID=
BNPB_PVMBG_READER_CLIENT_SECRET=
BNPB_AGGREGATOR_INTERNAL_KEY=
# Privileged migration/authority DSN; runtime read/write uses restricted writer URLs.
BNPB_CANONICAL_DATABASE_URL=
# Optional startup-only placement JSON from an Aggregator-only ConfigMap; blank preserves storage.
BNPB_SHARD_PLACEMENT=
# Must embed the same publisher user/password provisioned below, e.g.
# amqp://<BNPB_RABBITMQ_PUBLISHER_USER>:<BNPB_RABBITMQ_PUBLISHER_PASSWORD>@rabbitmq:5672
BNPB_AMQP_URL=
BNPB_HAZARD_EXCHANGE=hazard.events

# broker-init provisions one RabbitMQ user per identity below, each scoped to
# only its own queue (see bnpb/broker/provision.sh). Keep actual secrets out
# of Git; usernames double as queue role names (hazard.events.<user>).
BNPB_RABBITMQ_PUBLISHER_USER=publisher
BNPB_RABBITMQ_PUBLISHER_PASSWORD=
BNPB_CONSUMER_1_RABBITMQ_USER=dashboard
BNPB_CONSUMER_1_RABBITMQ_PASSWORD=
BNPB_CONSUMER_2_RABBITMQ_USER=notifications
BNPB_CONSUMER_2_RABBITMQ_PASSWORD=
BNPB_CONSUMER_3_RABBITMQ_USER=demo
BNPB_CONSUMER_3_RABBITMQ_PASSWORD=

BNPB_BMKG_POLL_INTERVAL=3s
BNPB_PVMBG_POLL_INTERVAL=3s
BNPB_BMKG_HTTP_TIMEOUT=1s
BNPB_PVMBG_HTTP_TIMEOUT=5s

# Separate HTTP cycle budget covers reader login + report; each call still has its own timeout.
BNPB_PVMBG_CYCLE_TIMEOUT=12s

BNPB_POLL_OVERLAP=2s
# Equal-jitter exponential backoff ceiling; Retry-After can require a longer cancellable wait.
BNPB_RETRY_MAX_BACKOFF=15s
BNPB_WARNING_RECONCILE_INTERVAL=60s

BNPB_SOURCE_STALE_AFTER=20s

# Response bytes: 1..134217728 (128 MiB); default 32 MiB.
BNPB_INGEST_MAX_RESPONSE_BYTES=33554432
BNPB_INGEST_CHUNK_RECORDS=100
BNPB_DB_READ_MAX_CONNS=16
BNPB_DB_WRITE_MAX_CONNS=4
BNPB_DB_READ_TIMEOUT=200ms
BNPB_DB_WRITE_TIMEOUT=2s
# Bounded read admission; must not exceed BNPB_DB_READ_MAX_CONNS.
BNPB_READ_MAX_IN_FLIGHT=4
BNPB_LIST_DEFAULT_LIMIT=100
BNPB_LIST_MAX_LIMIT=500
BNPB_PUBLISH_TIMEOUT=5s
# Pending fetch count; byte retention also uses BNPB_INGEST_MAX_RESPONSE_BYTES.
BNPB_OUTBOX_BATCH_SIZE=100

# PVMBG schema adaptation, empty = strict. See contracts/v1/README.md (Kebijakan Perubahan Skema PVMBG).
# Example values: level:alert_level | eruption_count_24h | received_at
BNPB_PVMBG_FIELD_ALIASES=
BNPB_PVMBG_NUMERIC_STRINGS=
BNPB_PVMBG_MISSING_TIME_FALLBACK=

# Optional M2 feature settings. Keep disabled unless their matching services,
# credentials, physical stores and host authority are configured together.
# Migration/authority DSNs (BNPB_CANONICAL_DATABASE_URL and shard DATABASE_URLs)
# use privileged credentials. Writer URLs are restricted runtime read/write
# connections to the same database targets, with distinct credentials.
# Routed stores require all three shard DSNs; Kubernetes takes them from
# aggregator-secrets with a nonoptional reference for BNPB_SHARD_0_DATABASE_URL.
# BNPB_SHARD_0_DATABASE_URL=
# BNPB_SHARD_1_DATABASE_URL=
# BNPB_SHARD_2_DATABASE_URL=
# BNPB_CANONICAL_WRITER_DATABASE_URL=
# BNPB_SHARD_0_WRITER_DATABASE_URL=
# BNPB_SHARD_1_WRITER_DATABASE_URL=
# BNPB_SHARD_2_WRITER_DATABASE_URL=
# Dedicated Audit identity; never reuse the Aggregator internal key.
# BNPB_AUDIT_TOKEN=
# Audit checksum deadline and starting analytics budget; default 5s, range 1ms..1m.
# Analytics clamps this below BNPB_WRITE_TIMEOUT. Public read timeout is unchanged.
# BNPB_AUDIT_CHECKSUM_TIMEOUT=5s
# Metadata-only Member 3 API; configure URL and service token together.
# The Aggregator serves it itself at /internal/dlq/unprocessed when the token is set,
# e.g. BNPB_UNPROCESSED_API_URL=http://aggregator:8083/internal/dlq/unprocessed
# BNPB_UNPROCESSED_API_URL=
# BNPB_UNPROCESSED_API_TOKEN=
# JSON array of explicitly configured physical copy PostgreSQL URLs.
# BNPB_STORAGE_COPY_DATABASE_URLS=
# Kubernetes-only standby repair, Secret JSON; supply a prebound node-local
# claim on a blank disk, mounted at the explicit Patroni data_dir / PGDATA path.
# Requires the configured Authority Kubernetes token/CA. Leave unset locally.
# BNPB_SHARD_REPAIR_CANDIDATES=
# Dedicated catalog credential; distinct from Audit and internal keys.
# BNPB_CATALOG_TOKEN=
# Authority is all-or-none: Kubernetes ConfigMap CAS and independent host timer.
# BNPB_AUTHORITY_KUBERNETES_SERVER_URL=
# BNPB_AUTHORITY_KUBERNETES_NAMESPACE=
# BNPB_AUTHORITY_KUBERNETES_CONFIGMAP=
# BNPB_AUTHORITY_KUBERNETES_TOKEN_FILE=
# BNPB_AUTHORITY_KUBERNETES_CA_FILE=
# BNPB_AUTHORITY_HOST_BASE_URL=
# Kubernetes projects these files from aggregator-secrets keys
# host-fence-token and host-fence-ca.crt; never put actual credentials here.
# BNPB_AUTHORITY_HOST_TOKEN_FILE=
# BNPB_AUTHORITY_HOST_CA_FILE=
# Kubernetes owner identity: injected spec.nodeName and a ConfigMap JSON object
# mapping each node name to its dedicated UUID from BNPB_AUTHORITY_DOMAINS.
# BNPB_K8S_NODE_NAME=
# BNPB_AUTHORITY_NODE_DOMAINS=
# Non-Kubernetes owner identity: an allowed literal UUID. Do not mix the modes.
# BNPB_AUTHORITY_OWNER_DOMAIN_UUID=
# Optional private Aggregator owner origin for routed Catalog writes; HTTP(S) origin only.
# BNPB_AUTHORITY_OWNER_ENDPOINT=
# Host-native bounded JSON bindings (DSN + schema per physical guard target)
# and privileged guard-only credentials are required separately. No A2
# mappings, credentials, or native Secret/config paths are supplied here.
# BNPB_AUTHORITY_DOMAINS=
# Renewal interval; protocol budget, not measured native timing.
# BNPB_AUTHORITY_RENEWAL_INTERVAL=5s
