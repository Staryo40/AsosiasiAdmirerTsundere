POSTGRES_DB=bnpb
POSTGRES_USER=bnpb
POSTGRES_PASSWORD=
RABBITMQ_DEFAULT_USER=bnpb
RABBITMQ_DEFAULT_PASS=

# Shared service platform settings
BNPB_LOG_LEVEL=INFO
BNPB_MAX_IN_FLIGHT=64
BNPB_OUTBOUND_HTTP_TIMEOUT=5s
BNPB_READ_HEADER_TIMEOUT=5s
BNPB_READ_TIMEOUT=10s
BNPB_WRITE_TIMEOUT=10s
BNPB_IDLE_TIMEOUT=60s
BNPB_SHUTDOWN_TIMEOUT=10s

# Per-service listen addresses
BNPB_API_HTTP_ADDR=:8080
BNPB_AGGREGATOR_HTTP_ADDR=:8083
BNPB_AUTH_HTTP_ADDR=:8084
BNPB_CONSUMER_1_HTTP_ADDR=:8085
BNPB_CONSUMER_2_HTTP_ADDR=:8086
BNPB_CONSUMER_3_HTTP_ADDR=:8087

# Aggregator-only settings
BNPB_BMKG_BASE_URL=http://bmkg:8081
BNPB_PVMBG_BASE_URL=http://pvmbg:8082

BNPB_BMKG_API_KEY=
BNPB_PVMBG_READER_CLIENT_ID=
BNPB_PVMBG_READER_CLIENT_SECRET=
BNPB_AGGREGATOR_INTERNAL_KEY=
# Aggregator DB and AMQP writer URLs: postgres(ql):// and amqp(s)://.
BNPB_CANONICAL_DATABASE_URL=
BNPB_AMQP_URL=
BNPB_HAZARD_EXCHANGE=hazard.events

BNPB_BMKG_POLL_INTERVAL=3s
BNPB_PVMBG_POLL_INTERVAL=3s
BNPB_BMKG_HTTP_TIMEOUT=1s
BNPB_PVMBG_HTTP_TIMEOUT=5s

# Separate HTTP cycle budget covers reader login + report; each call still has its own timeout.
BNPB_PVMBG_CYCLE_TIMEOUT=12s

BNPB_POLL_OVERLAP=2s
# Equal-jitter exponential backoff ceiling; Retry-After can require a longer cancellable wait.
BNPB_RETRY_MAX_BACKOFF=15s
BNPB_WARNING_RECONCILE_INTERVAL=60s

BNPB_SOURCE_STALE_AFTER=20s

# Response bytes: 1..134217728 (128 MiB); default 32 MiB.
BNPB_INGEST_MAX_RESPONSE_BYTES=33554432
BNPB_INGEST_CHUNK_RECORDS=100
BNPB_DB_READ_MAX_CONNS=16
BNPB_DB_WRITE_MAX_CONNS=4
BNPB_DB_READ_TIMEOUT=200ms
BNPB_DB_WRITE_TIMEOUT=2s
BNPB_READ_MAX_IN_FLIGHT=32
BNPB_LIST_DEFAULT_LIMIT=100
BNPB_LIST_MAX_LIMIT=500
BNPB_PUBLISH_TIMEOUT=5s
BNPB_OUTBOX_BATCH_SIZE=100
