# PVMBG configuration. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.
# `./gradlew run` loads `.env` automatically; in Docker, pass the same variables to the container.
#
# Each variable below states:
#   Used by: who holds or reads this value
#   Purpose: how it is used and what for

# --- Signing key ---------------------------------------------------------

# Used by: PVMBG only. It is never given to any client or to another service.
# Purpose: the secret key that PVMBG signs its JWT access tokens with (at POST /auth/login) and uses to
#          verify the signature of every incoming Bearer token. Whoever knows it can forge valid tokens.
#          Use at least 32 random characters, e.g. `openssl rand -hex 32`.
PVMBG_JWT_SECRET=change-me-to-a-long-random-string

# --- Reader client (read-only access) -------------------------------------

# Used by: the caller that only reads data, e.g. the BNPB gateway polling PVMBG. PVMBG checks it at login.
# Purpose: the reader's login name. Sent as `client_id` in the body of POST /auth/login. PVMBG also uses it
#          to identify this client for the login rate limit. A token issued for it carries scope `read`,
#          which allows GET /volcanic-reports (GET /health is public).
PVMBG_READER_CLIENT_ID=reader-client

# Used by: the same reader caller, which keeps it private. PVMBG compares it in constant time at login.
# Purpose: the reader's password. Sent as `client_secret` in the body of POST /auth/login together with
#          PVMBG_READER_CLIENT_ID. A wrong id or secret gets a generic 401.
PVMBG_READER_CLIENT_SECRET=change-me

# --- Admin client (read + admin access) -----------------------------------

# Used by: the demo operator (you, via Postman), and nothing automated. PVMBG checks it at login.
# Purpose: the admin's login name. Sent as `client_id` in the body of POST /auth/login. A token issued for it
#          carries scope `admin`, which allows POST /admin/schema-version and POST /admin/outage, and also
#          everything the reader can do. Admin login stays available while an outage is simulated, so the
#          outage can be switched off again.
PVMBG_ADMIN_CLIENT_ID=admin-client

# Used by: the demo operator, who keeps it private. PVMBG compares it in constant time at login.
# Purpose: the admin's password. Sent as `client_secret` in the body of POST /auth/login together with
#          PVMBG_ADMIN_CLIENT_ID. Keep it different from the reader secret so the two roles stay separate.
PVMBG_ADMIN_CLIENT_SECRET=change-me-too

# --- Optional tuning (defaults shown) -------------------------------------

# Used by: PVMBG when it issues a token; every client sees the value as `expires_in` in the login response.
# Purpose: how long an access token stays valid, in seconds. When it expires the client must log in again.
#          Default 300 (5 minutes). Use 30-60 to demonstrate expiry live.
PVMBG_TOKEN_TTL_SECONDS=300

# Used by: PVMBG's POST /auth/login endpoint, applied to every caller of that endpoint.
# Purpose: the maximum login attempts allowed per minute for one client id (unknown ids are counted per
#          IP address instead). Attempts beyond it get 429 Too Many Requests with a Retry-After header.
#          Default 5. Set it low to demonstrate the limiter.
PVMBG_LOGIN_RATE_LIMIT=5

# Used by: PVMBG only, in the code that slows down its responses. No other service reads it.
# Purpose: the lower bound, in milliseconds, of the random delay added to every response except /admin/*.
#          Simulates PVMBG's slow legacy infrastructure. Default 500. Use 0 for no delay.
#          Must not be greater than PVMBG_RESPONSE_DELAY_MAX_MS, otherwise PVMBG refuses to start.
#          This is only the starting value: the admin can change it without a restart through
#          POST /admin/response-delay, which also releases any request currently waiting out its delay.
PVMBG_RESPONSE_DELAY_MIN_MS=500

# Used by: PVMBG only, in the code that slows down its responses. No other service reads it.
# Purpose: the upper bound, in milliseconds, of the same random delay. Default 3000.
#          Set both this and the minimum to 3000 for a fixed 3-second delay, as the load test needs.
PVMBG_RESPONSE_DELAY_MAX_MS=3000

# Used by: PVMBG's logging system only, read when the service starts. No other service reads it.
# Purpose: the minimum severity that is written to the log: TRACE, DEBUG, INFO, WARN, ERROR or OFF.
#          Default INFO. DEBUG adds the most detailed lines (useful while developing); WARN keeps only problems.
#          Anything else stops PVMBG from starting, so a typo cannot silently change what is logged.
PVMBG_LOG_LEVEL=INFO

# Used by: PVMBG's logging system, and by whoever reads the output (`docker compose logs`, the load test, the demo).
# Purpose: the shape of every log line. `json` (default) writes one JSON object per line with fixed field names,
#          for machines and for searching by correlation id. `text` writes readable lines for a developer's console.
#          Must be lowercase; anything else stops PVMBG from starting.
PVMBG_LOG_FORMAT=json
